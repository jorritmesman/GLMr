&glm_setup
   sim_name = 'GLMSimulation'
   max_layers = 152
   min_layer_vol = 0.1
   min_layer_thick = 0.15
   max_layer_thick = 1
   density_model = 1
/
&light
   light_mode = 0
   n_bands = 4
   light_extc = 1, 0.5, 2, 4
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Benthic_Imin = 10
   Kw = 0.68,
/
&mixing
   surface_mixing = 1
   coef_mix_conv = 0.2
   coef_wind_stir = 0.23
   coef_mix_shear = 0.3
   coef_mix_turb = 0.51
   coef_mix_KH = 0.3
   coef_mix_hyp = 0.5
   deep_mixing = 2
   diff = 0
/
&morphometry
   lake_name = 'Erken'
   latitude = 59.9
   longitude = 18.6
   bsn_len = 7763.708
   bsn_wid = 3881.854
   bsn_vals = 12
   H = -11, -10, -8, -6, -4, -2, 0, 2, 4, 6, 8, 10
   A = 0, 10000, 160000, 1420000, 3220000, 7410000, 11610000, 14180000, 16590000, 1.9e+07, 21380000, 23670000
   crest_elev = 10
/
&time
   timefmt = 2
   start = '2010-01-01 00:00:00'
   stop = '2013-01-01 00:00:00'
   dt = 3600
   num_days = 730
   timezone = 0
/
&output
   out_dir = 'output'
   out_fn = 'output'
   nsave = 24
   csv_lake_fname = 'lake'
/
&init_profiles
   lake_depth = 21
   num_depths = 4
   the_depths = 1, 3, 10, 15
   the_temps = 1.23, 1.68, 2.5, 2.95
   the_sals = 0, 0, 0, 0
/
&meteorology
   met_sw = .true.
   lw_type = 'LW_IN'
   rain_sw = .false.
   atm_stab = 0
   catchrain = .false.
   rad_mode = 1
   albedo_mode = 1
   cloud_mode = 4
   meteo_fl = 'meteo_file.csv'
   subdaily = .true.
   wind_factor = 1
   sw_factor = 1
   lw_factor = 1
   at_factor = 1
   rh_factor = 1
   rain_factor = 1
   cd = 0.0013
   ce = 0.0013
   ch = 0.0013
   rain_threshold = 0.01
   runoff_coef = 0.3
   time_fmt = 'YYYY-MM-DD hh:mm:ss'
/
&inflow
   num_inflows = 1
   names_of_strms = 'inflow_1'
   subm_flag = .false., .false.
   strm_hf_angle = 65
   strmbd_slope = 2
   strmbd_drag = 0.016
   inflow_factor = 1
   inflow_fl = 'inflow_1.csv'
   inflow_varnum = 3
   inflow_vars = 'FLOW','SALT','TEMP'
/
&outflow
   num_outlet = 1
   outl_elvs = 0
   bsn_len_outl = 799
   bsn_wid_outl = 398
   outflow_fl = 'outflow_1.csv'
   outflow_factor = 1
   flt_off_sw = .true.
   crest_width = 100
   crest_factor = 0.61
/
&snowice
   snow_albedo_factor = 1
   snow_rho_max = 500
   snow_rho_min = 100
/
